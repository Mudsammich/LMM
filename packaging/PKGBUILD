# Maintainer: you <you@example.com>
# PKGBUILD for building LMM (Linux Mod Manager) from a local checkout on
# Arch-based distros, including CachyOS.
#
# Build + install with:
#   cd packaging && makepkg -si
#
# python-vdf is AUR-only. Build it first with an AUR helper (e.g.
# `paru -S python-vdf`) or let your AUR helper resolve it automatically if
# you run `paru -Bi packaging/` instead of makepkg directly. Everything
# else below (including pyside6, python-py7zr, python-rarfile) is in the
# official [extra] repo.
#
# pkgver() derives from the current git commit rather than a hardcoded
# string, so every new commit produces a version AUR helpers recognise as
# new - `paru -Bi` won't silently skip rebuilding a stale cached version
# after pulling new source.
#
# The revision is the commit's *timestamp*, not a commit count. A count
# isn't monotonic: squash-merging a branch collapses many commits into one,
# so the next build's count is far lower than the previous build's and
# pacman reports newer code as a downgrade. A timestamp only ever goes up,
# whatever happens to the history.

pkgname=lmm
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux Mod Manager - Nexus Mods downloads, Proton prefix linking, and mod deployment"
arch=('any')
url="https://github.com/mudsammich/lmm"
license=('MIT')
depends=(
	'python'
	'pyside6'
	'python-requests'
	'python-platformdirs'
	'python-vdf'
	'python-py7zr'
	'python-rarfile'
	'xdg-utils'
	'hicolor-icon-theme'
)
optdepends=(
	'unrar: better .rar mod archive support'
	'proton-ge-custom: wider Proton compatibility for running mod tools'
	'bubblewrap: network-isolated game launches (Games > Launch Game)'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
install=lmm.install
source=()
sha256sums=()

pkgver() {
	cd "$startdir/.." || { echo "pkgver(): cannot cd to \$startdir/.. ($startdir/..)" >&2; return 1; }
	if ! git rev-parse --git-dir >/dev/null 2>&1; then
		echo "pkgver(): $(pwd) is not a git repository - \$startdir is '$startdir'" >&2
		return 1
	fi
	printf '0.1.0.r%s.g%s' \
		"$(git log -1 --format=%cd --date=format:%Y%m%d%H%M)" \
		"$(git rev-parse --short HEAD)"
}

build() {
	cd "$startdir/.."
	python -m build --wheel --no-isolation
}

package() {
	cd "$startdir/.."
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 packaging/lmm.desktop "$pkgdir/usr/share/applications/lmm.desktop"
	for size in 16 24 32 48 64 128 256; do
		install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/lmm.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/lmm.png"
	done
	install -Dm644 packaging/icons/hicolor/scalable/apps/lmm.svg \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/lmm.svg"
}
