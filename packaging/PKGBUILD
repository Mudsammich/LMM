# Maintainer: you <you@example.com>
# PKGBUILD for building LMM (Linux Mod Manager) from a local checkout on
# Arch-based distros, including CachyOS.
#
# Build + install with:
#   cd packaging && makepkg -si
#
# python-vdf is AUR-only. Build it first with an AUR helper (e.g.
# `paru -S python-vdf`) or let your AUR helper resolve it automatically if
# you run `paru -Bi packaging/` instead of makepkg directly. Everything
# else below (including pyside6, python-py7zr, python-rarfile) is in the
# official [extra] repo.
#
# pkgver() derives from the current git commit (0.1.0.r<count>.g<hash>),
# not a hardcoded string, so every new commit produces a version AUR
# helpers recognize as new - `paru -Bi` won't silently skip rebuilding a
# stale cached version after you pull new source changes.

pkgname=lmm
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux Mod Manager - Nexus Mods downloads, Proton prefix linking, and mod deployment"
arch=('any')
url="https://github.com/mudsammich/lmm"
license=('MIT')
depends=(
	'python'
	'pyside6'
	'python-requests'
	'python-platformdirs'
	'python-vdf'
	'python-py7zr'
	'python-rarfile'
	'xdg-utils'
)
optdepends=(
	'unrar: better .rar mod archive support'
	'proton-ge-custom: wider Proton compatibility for running mod tools'
	'bubblewrap: network-isolated game launches (Games > Launch Game)'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=()
sha256sums=()

pkgver() {
	cd "$startdir/.."
	printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd "$startdir/.."
	python -m build --wheel --no-isolation
}

package() {
	cd "$startdir/.."
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 packaging/lmm.desktop "$pkgdir/usr/share/applications/lmm.desktop"
}
